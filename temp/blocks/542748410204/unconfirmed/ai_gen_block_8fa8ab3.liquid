    height: 18px;
  }

  .ai-multistep-form__buttons-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
    gap: 10px;
  }

  .ai-multistep-form__button-{{ ai_gen_id }} {
