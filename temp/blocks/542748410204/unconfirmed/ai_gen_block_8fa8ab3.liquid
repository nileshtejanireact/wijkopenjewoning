{% doc %}
  @prompt
    Fix the multi-step "Bod aanvragen" form block. Make these changes: 1. Change all form field names from Shopify contact format (e.g. contact[naam]) to plain names (e.g. naam, email, telefoon, etc.) 2. Change the form action to POST to external URL: https://www.greatwebdev.com/wijkopenjewoning.php 3. Fix the final review/summary step so it correctly displays all values the user filled in previous steps (currently showing blank)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multistep-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-multistep-form__progress-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    position: relative;
  }

  .ai-multistep-form__progress-line-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: {{ block.settings.progress_inactive_color }};
    z-index: 0;
  }

  .ai-multistep-form__progress-fill-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: {{ block.settings.progress_active_color }};
    transition: width 0.3s ease;
  }

  .ai-multistep-form__step-indicator-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  .ai-multistep-form__step-circle-{{ ai_gen_id }} {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: {{ block.settings.progress_inactive_color }};
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 8px;
    transition: background-color 0.3s ease;
  }

  .ai-multistep-form__step-indicator-{{ ai_gen_id }}.active .ai-multistep-form__step-circle-{{ ai_gen_id }},
  .ai-multistep-form__step-indicator-{{ ai_gen_id }}.completed .ai-multistep-form__step-circle-{{ ai_gen_id }} {
    background-color: {{ block.settings.progress_active_color }};
    color: {{ block.settings.progress_text_color }};
  }

  .ai-multistep-form__step-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-multistep-form__content-{{ ai_gen_id }} {
    min-height: 300px;
  }

  .ai-multistep-form__step-{{ ai_gen_id }} {
    display: none;
  }

  .ai-multistep-form__step-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-multistep-form__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
  }

  .ai-multistep-form__field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-multistep-form__label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-multistep-form__input-{{ ai_gen_id }},
  .ai-multistep-form__textarea-{{ ai_gen_id }},
  .ai-multistep-form__select-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-multistep-form__textarea-{{ ai_gen_id }} {
    min-height: 100px;
    resize: vertical;
  }

  .ai-multistep-form__radio-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ai-multistep-form__radio-option-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-multistep-form__radio-option-{{ ai_gen_id }} input[type="radio"] {
