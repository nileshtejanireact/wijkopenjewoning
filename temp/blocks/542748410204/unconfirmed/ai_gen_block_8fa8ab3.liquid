<script>
  (function() {
    class MultiStepForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.totalSteps = 4;
        this.formData = {};
      }

      connectedCallback() {
        this.form = this.querySelector('[data-multistep-form]');
        this.steps = this.querySelectorAll('[data-step]');
        this.stepIndicators = this.querySelectorAll('[data-step-indicator]');
        this.progressFill = this.querySelector('[data-progress-fill]');
        this.nextBtn = this.querySelector('[data-next-btn]');
        this.prevBtn = this.querySelector('[data-prev-btn]');
        this.submitBtn = this.querySelector('[data-submit-btn]');
        this.fields = this.querySelectorAll('[data-field]');

        this.setupEventListeners();
        this.updateProgress();
      }

      setupEventListeners() {
        this.nextBtn.addEventListener('click', () => this.nextStep());
        this.prevBtn.addEventListener('click', () => this.prevStep());
        
        this.fields.forEach(field => {
          field.addEventListener('change', (e) => this.saveFieldData(e.target));
          field.addEventListener('input', (e) => this.saveFieldData(e.target));
        });
      }

      saveFieldData(field) {
        const fieldName = field.getAttribute('data-field');
        if (field.type === 'radio') {
          if (field.checked) {
            this.formData[fieldName] = field.value;
          }
        } else {
          this.formData[fieldName] = field.value;
        }
      }

      validateStep() {
        const currentStepElement = this.querySelector(`[data-step="${this.currentStep}"]`);
        const requiredFields = currentStepElement.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          const errorElement = currentStepElement.querySelector(`[data-error="${field.getAttribute('data-field')}"]`);
          
          if (field.type === 'radio') {
            const radioGroup = currentStepElement.querySelectorAll(`[name="${field.name}"]`);
            const isChecked = Array.from(radioGroup).some(radio => radio.checked);
            
            if (!isChecked) {
              isValid = false;
              if (errorElement) {
                errorElement.textContent = 'Dit veld is verplicht';
              }
            } else {
              if (errorElement) {
                errorElement.textContent = '';
              }
            }
          } else {
            if (!field.value.trim()) {
              isValid = false;
              if (errorElement) {
                errorElement.textContent = 'Dit veld is verplicht';
              }
            } else {
              if (errorElement) {
                errorElement.textContent = '';
              }
            }
          }
        });

        return isValid;
      }

      nextStep() {
        if (!this.validateStep()) {
          return;
        }

        if (this.currentStep < this.totalSteps) {
          this.currentStep++;
          this.updateSteps();
          this.updateProgress();
          this.updateButtons();
          
          if (this.currentStep === this.totalSteps) {
            this.updateSummary();
          }
        }
      }

      prevStep() {
        if (this.currentStep > 1) {
          this.currentStep--;
          this.updateSteps();
          this.updateProgress();
          this.updateButtons();
        }
      }

      updateSteps() {
        this.steps.forEach((step, index) => {
          if (index + 1 === this.currentStep) {
            step.classList.add('active');
          } else {
            step.classList.remove('active');
          }
        });

        this.stepIndicators.forEach((indicator, index) => {
          if (index + 1 < this.currentStep) {
            indicator.classList.add('completed');
            indicator.classList.remove('active');
          } else if (index + 1 === this.currentStep) {
            indicator.classList.add('active');
            indicator.classList.remove('completed');
          } else {
            indicator.classList.remove('active', 'completed');
          }
        });
      }

      updateProgress() {
        const progress = ((this.currentStep - 1) / (this.totalSteps - 1)) * 100;
        this.progressFill.style.width = progress + '%';
      }

      updateButtons() {
        if (this.currentStep === 1) {
          this.prevBtn.style.display = 'none';
        } else {
          this.prevBtn.style.display = 'block';
        }

        if (this.currentStep === this.totalSteps) {
          this.nextBtn.style.display = 'none';
          this.submitBtn.style.display = 'block';
        } else {
          this.nextBtn.style.display = 'block';
          this.submitBtn.style.display = 'none';
        }
      }

      updateSummary() {
        const summaryElements = this.querySelectorAll('[data-summary]');
        
        summaryElements.forEach(element => {
          const fieldName = element.getAttribute('data-summary');
          const value = this.formData[fieldName] || '-';
          element.textContent = value;
        });
      }
    }

    customElements.define('multi-step-form-{{ ai_gen_id }}', MultiStepForm{{ ai_gen_id }});
  })();
</script>

