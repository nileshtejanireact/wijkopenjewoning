{% doc %}
  @prompt
    Update the "Waarom kiezen voor ons?" (Why choose us) AI-generated block. The block has 6 feature cards with Dutch text. Update the SVG icons to match each feature: 1. Binnen 24 Uur Een Bod → Clock icon, 2. Geen Financieringsvoorbehoud → Shield with checkmark icon, 3. Discrete Verkoop → Lock icon, 4. Geen Makelaarskosten → Euro money bag icon, 5. Snelle Afhandeling → Lightning bolt icon, 6. Bouwval / Verbouwing → House with wrench icon. Keep all styling, colors (icon color #ffd13b, size 32), and layout the same.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-container-{{ ai_gen_id }} {
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-wrapper-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-features-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin-bottom: 50px;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: 30px;
    border-radius: {{ block.settings.card_border_radius }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto 20px;
    color: {{ block.settings.icon_color }};
  }

  .ai-feature-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin-bottom: 10px;
    font-weight: 600;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 768px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-features-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-wrapper-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-features-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-features-grid-{{ ai_gen_id }}">
      <div class="ai-feature-card-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
        <p class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description }}</p>
      </div>

      <div class="ai-feature-card-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
        </div>
        <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
        <p class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
      </div>

      <div class="ai-feature-card-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
        <p class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
      </div>

      <div class="ai-feature-card-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ block.settings.feature_4_title }}</h3>
        <p class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_4_description }}</p>
      </div>

      <div class="ai-feature-card-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ block.settings.feature_5_title }}</h3>
        <p class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_5_description }}</p>
      </div>

      <div class="ai-feature-card-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
            <path d="M14 7h4M14 10h4"></path>
          </svg>
        </div>
        <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ block.settings.feature_6_title }}</h3>
        <p class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_6_description }}</p>
      </div>
    </div>
  </div>
</div>

