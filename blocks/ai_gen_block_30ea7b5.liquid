<script>
document.addEventListener('DOMContentLoaded', function() {
const form = document.getElementById('heroRedirectForm');
if (!form) {
console.log('Form not found');
return;
}
const errorBox = document.getElementById('heroError');

function showError(message) {
errorBox.innerHTML = message;
errorBox.classList.add('show');
}

function clearError() {
errorBox.innerHTML = '';
errorBox.classList.remove('show');
}
form.addEventListener('submit', function(e) {
e.preventDefault();
const postcodeField = document.querySelector('[name="postal_code"]');
const huisnummerField = document.querySelector('[name="house_number"]');
const toevoegingField = document.querySelector('[name="addition"]');

const postcode = postcodeField ? postcodeField.value.trim() : '';
const huisnummer = huisnummerField ? huisnummerField.value.trim() : '';
const toevoeging = toevoegingField ? toevoegingField.value.trim() : '';

const postcodeRegex = /^[1-9][0-9]{3}\s?[A-Za-z]{2}$/;
/*
if (!postcodeRegex.test(postcode)) {
  showError('Voer een geldige postcode in. Bijvoorbeeld: 1234 AB');
return;
}

if (!/^\d+$/.test(huisnummer) || parseInt(huisnummer) <= 0) {
  showError('Voer een geldig huisnummer in');
  return;
}

if (toevoeging && !/^[A-Za-z0-9\s-]{1,10}$/.test(toevoeging)) {
  showError('Voer een geldige toevoeging in');
  return;
}*/

sessionStorage.setItem('postcode', postcode);
sessionStorage.setItem('huisnummer', huisnummer);
sessionStorage.setItem('toevoeging', toevoeging);

window.location.href = '/pages/bod-aanvragen';
});

});

</script>