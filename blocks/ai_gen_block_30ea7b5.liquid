{% doc %}
  @prompt
    Regenerate the Hero with form block to exactly match Huisunie.nl layout.
    
    DESKTOP LAYOUT:
    - Full-width white form card
    - Single row: [Postal code input] [House number input] [Addition input] [Receive your bid button] — all in one flex row, inputs flex-grow, button fixed width, no wrapping
    - Below form: three checkmark items in ONE horizontal row: ✓ No renovation needed  ✓ No sales costs  ✓ No financing contingency — all inline, evenly spaced
    
    MOBILE LAYOUT:
    - Inputs stack vertically, each full width
    - Button full width below inputs
    - Checkmark items stack vertically one per line
    - Headline and subtitle left-aligned, readable font size
    
    STYLING:
    - Dark navy blue background overlay #0D2B5E
    - White form card, full content width, rounded corners, padding
    - Input fields: light border, placeholder text, no fill
    - CTA button: dark navy #0D2B5E, white text, rounded, same height as inputs
    - Checkmark icon: green or navy checkmark before each bullet
    - Rating badge: white pill with Rated 9.5 gold stars
    - White headline and subtitle text
    
    IMPORTANT: Do NOT use any CSS class names with ai- prefix. Use standard Horizon theme block types. Use flexbox for form row and bullet row. Fully responsive with proper mobile breakpoints.
{% enddoc %}
{% assign gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .hero-form-container-{{ gen_id }} {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.overlay_color }};
    background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    padding: 60px 20px;
  }

  .hero-form-overlay-{{ gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .hero-form-content-{{ gen_id }} {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
  }

  .hero-form-text-{{ gen_id }} {
    margin-bottom: 30px;
    max-width:800px;
  }

  .hero-form-heading-{{ gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .hero-form-subheading-{{ gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .hero-form-rating-{{ gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: {{ block.settings.rating_bg_color }};
    color: {{ block.settings.rating_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .hero-form-stars-{{ gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: 16px;
  }

  .hero-form-card-{{ gen_id }} {
    background-color: {{ block.settings.form_bg_color }};
    border-radius: {{ block.settings.form_border_radius }}px;
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .hero-form-row-{{ gen_id }} {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    align-items: stretch;
  }

  .hero-form-input-wrapper-{{ gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .hero-form-input-{{ gen_id }} {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
  }

  .hero-form-input-{{ gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    opacity: 0.7;
  }

  .hero-form-input-{{ gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .hero-form-button-wrapper-{{ gen_id }} {
    flex-shrink: 0;
    min-width: 200px;
  }

  .hero-form-button-{{ gen_id }} {
    width: 100%;
    height: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .hero-form-button-{{ gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .hero-form-features-{{ gen_id }} {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
  }

  .hero-form-feature-{{ gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.feature_text_color }};
    font-size: 15px;
  }

  .hero-form-checkmark-{{ gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .hero-form-checkmark-{{ gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.checkmark_color }};
  }

  @media screen and (max-width: 749px) {
    .hero-form-container-{{ gen_id }} {
      min-height: 400px;
      padding: 40px 16px;
    }

    .hero-form-heading-{{ gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .hero-form-subheading-{{ gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .hero-form-card-{{ gen_id }} {
      padding: 20px;
    }

    .hero-form-row-{{ gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .hero-form-button-wrapper-{{ gen_id }} {
      min-width: 100%;
    }

    .hero-form-features-{{ gen_id }} {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }

    .hero-form-text-{{ gen_id }} {
      text-align: left;
    }

    .hero-form-rating-{{ gen_id }} {
      margin-bottom: 16px;
    }
  }
{% endstyle %}

<div class="hero-form-container-{{ gen_id }}" {{ block.shopify_attributes }}>
  <div class="hero-form-overlay-{{ gen_id }}"></div>
  
  <div class="hero-form-content-{{ gen_id }}">
    <div class="hero-form-text-{{ gen_id }}">
      {% if block.settings.show_rating %}
        <div class="hero-form-rating-{{ gen_id }}">
          <span>{{ block.settings.rating_text }}</span>
          <span class="hero-form-stars-{{ gen_id }}">★★★★★</span>
        </div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h1 class="hero-form-heading-{{ gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}
      
      {% if block.settings.subheading != blank %}
        <p class="hero-form-subheading-{{ gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="hero-form-card-{{ gen_id }}">
     <form id="heroRedirectForm">
        <div class="hero-form-row-{{ gen_id }}">
          <div class="hero-form-input-wrapper-{{ gen_id }}">
            <input
              type="text"
              name="postal_code"
              class="hero-form-input-{{ gen_id }}"
              placeholder="{{ block.settings.postal_code_placeholder }}"
              required
            >
          </div>
          
          <div class="hero-form-input-wrapper-{{ gen_id }}">
            <input
              type="text"
              name="house_number"
              class="hero-form-input-{{ gen_id }}"
              placeholder="{{ block.settings.house_number_placeholder }}"
              required
            >
          </div>
          
          <div class="hero-form-input-wrapper-{{ gen_id }}">
            <input
              type="text"
              name="addition"
              class="hero-form-input-{{ gen_id }}"
              placeholder="{{ block.settings.addition_placeholder }}"
            >
          </div>
          
          <div class="hero-form-button-wrapper-{{ gen_id }}">
            <button type="submit" class="hero-form-button-{{ gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        </div>

        <div class="hero-form-features-{{ gen_id }}">
          {% if block.settings.feature_1 != blank %}
            <div class="hero-form-feature-{{ gen_id }}">
              <span class="hero-form-checkmark-{{ gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.feature_1 }}</span>
            </div>
          {% endif %}
          
          {% if block.settings.feature_2 != blank %}
            <div class="hero-form-feature-{{ gen_id }}">
              <span class="hero-form-checkmark-{{ gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.feature_2 }}</span>
            </div>
          {% endif %}
          
          {% if block.settings.feature_3 != blank %}
            <div class="hero-form-feature-{{ gen_id }}">
              <span class="hero-form-checkmark-{{ gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.feature_3 }}</span>
            </div>
          {% endif %}
        </div>
        <div class="error-message" id="heroError"></div>
      </form>
    </div>
  </div>
</div>

