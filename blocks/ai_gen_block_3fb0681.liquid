{% doc %}
  @prompt
    Create a "Why choose Huisunie?" features section with a 3-column icon card grid layout.
    
    SECTION HEADER:
    - Centered bold heading: "Why choose Huisunie?"
    - Light gray background #F7F8FA for the whole section
    
    CARD GRID LAYOUT:
    - 3 columns desktop, 1 column mobile
    - 6 total feature cards (2 rows of 3)
    - Each card: white background, rounded corners, padding, subtle shadow
    
    EACH CARD BLOCK contains:
    1. Icon top-left (dark navy SVG icon)
    2. Bold title (dark navy)
    3. Body description (dark gray)
    
    6 CARD BLOCKS:
    Card 1: Icon: shield, Title: "Immediate certainty and peace", Text: "You will receive a suitable offer within 24 hours and know exactly where you stand immediately. No uncertain proceeds and no lengthy sales process. The sale can be completed within a week."
    Card 2: Icon: document, Title: "Guaranteed sold", Text: "We purchase without a financing contingency or structural inspection. Any hidden defects are at our risk. Sold is truly sold."
    Card 3: Icon: bar chart, Title: "Maximum yield", Text: "You do not need to invest money in your home to sell. You pay no real estate agent fees, and we pay the notary fees. The agreed price is the amount you receive."
    Card 4: Icon: wrench, Title: "Sale in its current condition", Text: "You are selling your home as is. You do not need to renovate, tidy up, or clean."
    Card 5: Icon: calendar, Title: "Move when it suits you", Text: "The transfer can take place quickly, but also over 6-12 months, so that you can arrange everything at your own pace."
    Card 6: Icon: checklist, Title: "Fast and hassle-free process", Text: "No endless viewings or negotiations. We buy your home directly and handle everything for you."
    
    STYLING (Horizon theme colors and fonts):
    - Section bg: #F7F8FA
    - Card bg: white with soft shadow
    - Icon color: #0D2B5E
    - Title: bold, dark navy, Horizon heading font
    - Body: dark gray, Horizon body font
    - Section heading: large, bold, centered
    
    IMPORTANT: Each card is its own separate block for individual editing. Use Horizon theme standard block types. Do NOT use any CSS class names with ai- prefix. Responsive: 3 cols desktop, 1 col mobile.
{% enddoc %}
{% assign unique_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .features-section-{{ unique_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .features-container-{{ unique_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-heading-{{ unique_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
  }

  .features-grid-{{ unique_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin: 0;
  }

  .feature-card-{{ unique_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_content_gap }}px;
  }

  .feature-icon-{{ unique_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .feature-icon-{{ unique_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ block.settings.icon_color }};
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-title-{{ unique_id }} {
    margin: 0;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  .feature-description-{{ unique_id }} {
    margin: 0;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .features-grid-{{ unique_id }} {
      grid-template-columns: 1fr;
    }

    .features-heading-{{ unique_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .feature-title-{{ unique_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .feature-description-{{ unique_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="features-section-{{ unique_id }}" {{ block.shopify_attributes }}>
  <div class="features-container-{{ unique_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="features-heading-{{ unique_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="features-grid-{{ unique_id }}">
      <div class="feature-card-{{ unique_id }}">
        <div class="feature-icon-{{ unique_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="feature-title-{{ unique_id }}">{{ block.settings.card_1_title }}</h3>
        <p class="feature-description-{{ unique_id }}">{{ block.settings.card_1_description }}</p>
      </div>

      <div class="feature-card-{{ unique_id }}">
        <div class="feature-icon-{{ unique_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3 class="feature-title-{{ unique_id }}">{{ block.settings.card_2_title }}</h3>
        <p class="feature-description-{{ unique_id }}">{{ block.settings.card_2_description }}</p>
      </div>

      <div class="feature-card-{{ unique_id }}">
        <div class="feature-icon-{{ unique_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <line x1="12" y1="20" x2="12" y2="10"></line>
            <line x1="18" y1="20" x2="18" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="16"></line>
          </svg>
        </div>
        <h3 class="feature-title-{{ unique_id }}">{{ block.settings.card_3_title }}</h3>
        <p class="feature-description-{{ unique_id }}">{{ block.settings.card_3_description }}</p>
      </div>

      <div class="feature-card-{{ unique_id }}">
        <div class="feature-icon-{{ unique_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </div>
        <h3 class="feature-title-{{ unique_id }}">{{ block.settings.card_4_title }}</h3>
        <p class="feature-description-{{ unique_id }}">{{ block.settings.card_4_description }}</p>
      </div>

      <div class="feature-card-{{ unique_id }}">
        <div class="feature-icon-{{ unique_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <h3 class="feature-title-{{ unique_id }}">{{ block.settings.card_5_title }}</h3>
        <p class="feature-description-{{ unique_id }}">{{ block.settings.card_5_description }}</p>
      </div>

      <div class="feature-card-{{ unique_id }}">
        <div class="feature-icon-{{ unique_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <polyline points="9 11 12 14 22 4"></polyline>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
        </div>
        <h3 class="feature-title-{{ unique_id }}">{{ block.settings.card_6_title }}</h3>
        <p class="feature-description-{{ unique_id }}">{{ block.settings.card_6_description }}</p>
      </div>
    </div>
    <a href="/" class="size-style button" style="--size-style-width: fit-content;--size-style-height: ;--size-style-width-mobile: fit-content; --size-style-width-mobile-min: fit-content;margin: 20px auto;">
  Receive your free offer
</a>
  </div>
</div>

