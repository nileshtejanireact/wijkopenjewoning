{% doc %}
  @prompt
    Regenerate "Experiences of homeowners" testimonials carousel. Previous version had two bugs: arrows not visible and dots not round. Fix these specifically.
    
    CRITICAL FIX 1 - ARROWS MUST BE VISIBLE:
    - HTML button elements with explicit inline styles
    - Width: 44px, Height: 44px, border-radius: 50%
    - Background: #ffffff, Border: 2px solid #0D2B5E, Color: #0D2B5E
    - Display: flex, align-items: center, justify-content: center
    - Position: absolute, top: 50%, transform: translateY(-50%)
    - Left arrow: left: -22px, Right arrow: right: -22px
    - Z-index: 10, cursor: pointer
    - Use SVG chevron icons inside buttons
    - NEVER hide with display:none or visibility:hidden
    
    CRITICAL FIX 2 - DOTS MUST BE PERFECT CIRCLES:
    - Each dot: width: 10px, height: 10px, border-radius: 50% explicitly
    - Display: inline-block
    - Active: background #0D2B5E, no border
    - Inactive: transparent bg, 2px solid #0D2B5E border
    - Gap: 8px, container: flex, justify-content: center, margin-top: 24px
    
    KEEP SAME:
    - Section bg #F5F0EB, centered Rated 9.5 gold stars top, large bold centered heading "Experiences of homeowners" dark navy
    - 4 white review cards: rounded, shadow, gold stars, review text, navy avatar circle white initial, bold name, gray location
    - Card1: S Sarah Johnson New York - Card2: M Michael Chen San Francisco - Card3: E Emma Williams London - Card4: D David Martinez Miami
    - Infinite loop via cloned slides, auto-play 5s, pause on hover, touch swipe mobile
    - 4 cards desktop, 2 tablet, 1 mobile
    - Each card separate schema block
    - var(--font-heading-family) and var(--font-body-family)
    - No ai- class names, vanilla JS only
{% enddoc %}
{% assign gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .testimonials-carousel-{{gen_id}} {
    display: block;
    background-color: #F5F0EB;
    padding: 60px 20px;
    width: 100%;
  }

  .testimonials-carousel-container-{{gen_id}} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonials-carousel-rating-{{gen_id}} {
    text-align: center;
    margin-bottom: 16px;
  }

  .testimonials-carousel-rating-text-{{gen_id}} {
    font-family: var(--font-body-family);
    font-size: 14px;
    color: #0D2B5E;
    margin-bottom: 8px;
  }

  .testimonials-carousel-stars-{{gen_id}} {
    display: flex;
    justify-content: center;
    gap: 4px;
  }

  .testimonials-carousel-star-{{gen_id}} {
    width: 20px;
    height: 20px;
    fill: #FFD700;
  }

  .testimonials-carousel-heading-{{gen_id}} {
    font-family: var(--font-heading-family);
    font-size: 48px;
    font-weight: 700;
    color: #0D2B5E;
    text-align: center;
    margin: 0 0 40px 0;
  }

  .testimonials-carousel-wrapper-{{gen_id}} {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonials-carousel-track-container-{{gen_id}} {
    overflow: hidden;
    position: relative;
  }

  .testimonials-carousel-track-{{gen_id}} {
    display: flex;
    gap: 24px;
    transition: transform 0.5s ease;
  }

  .testimonials-carousel-card-{{gen_id}} {
    flex: 0 0 calc(25% - 18px);
    background: #FFFFFF;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .testimonials-carousel-card-stars-{{gen_id}} {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .testimonials-carousel-card-star-{{gen_id}} {
    width: 16px;
    height: 16px;
    fill: #FFD700;
  }

  .testimonials-carousel-card-text-{{gen_id}} {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.6;
    color: #333333;
    margin-bottom: 20px;
  }

  .testimonials-carousel-card-author-{{gen_id}} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonials-carousel-card-avatar-{{gen_id}} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #0D2B5E;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 16px;
    flex-shrink: 0;
  }

  .testimonials-carousel-card-author-info-{{gen_id}} {
    flex: 1;
  }

  .testimonials-carousel-card-author-name-{{gen_id}} {
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 14px;
    color: #0D2B5E;
    margin: 0 0 4px 0;
  }

  .testimonials-carousel-card-author-location-{{gen_id}} {
    font-family: var(--font-body-family);
    font-size: 12px;
    color: #999999;
    margin: 0;
  }

  .testimonials-carousel-arrow-{{gen_id}} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #0D2B5E;
    color: #0D2B5E;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .testimonials-carousel-arrow-{{gen_id}}:hover {
    background: #0D2B5E;
    color: #ffffff;
  }

  .testimonials-carousel-arrow-left-{{gen_id}} {
    left: -22px;
  }

  .testimonials-carousel-arrow-right-{{gen_id}} {
    right: -22px;
  }

  .testimonials-carousel-arrow-icon-{{gen_id}} {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
  }

  .testimonials-carousel-dots-{{gen_id}} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .testimonials-carousel-dot-{{gen_id}} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: transparent;
    border: 2px solid #0D2B5E;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .testimonials-carousel-dot-{{gen_id}}.active {
    background: #0D2B5E;
    border: none;
  }

  @media screen and (max-width: 989px) {
    .testimonials-carousel-card-{{gen_id}} {
      flex: 0 0 calc(50% - 12px);
    }

    .testimonials-carousel-heading-{{gen_id}} {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    .testimonials-carousel-card-{{gen_id}} {
      flex: 0 0 100%;
    }

    .testimonials-carousel-heading-{{gen_id}} {
      font-size: 28px;
    }

    .testimonials-carousel-arrow-{{gen_id}} {
      display: none;
    }
  }
{% endstyle %}

