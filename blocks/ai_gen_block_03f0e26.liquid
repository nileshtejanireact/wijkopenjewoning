<script>
(function() {
  class TestimonialsCarousel{{gen_id}} extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.autoplayInterval = null;
      this.isTransitioning = false;
    }

    connectedCallback() {
      this.track = this.querySelector('.testimonials-carousel-track-{{gen_id}}');
      this.cards = Array.from(this.querySelectorAll('.testimonials-carousel-card-{{gen_id}}'));
      this.dotsContainer = this.querySelector('.testimonials-carousel-dots-{{gen_id}}');
      this.prevButton = this.querySelector('.testimonials-carousel-arrow-left-{{gen_id}}');
      this.nextButton = this.querySelector('.testimonials-carousel-arrow-right-{{gen_id}}');

      if (this.cards.length === 0) return;

      this.cloneSlides();
      this.createDots();
      this.setupEventListeners();
      this.updateCarousel(false);
      this.startAutoplay();
    }

    cloneSlides() {
      const cardsPerView = this.getCardsPerView();
      const clonesToAdd = Math.max(cardsPerView, this.cards.length);

      for (let i = 0; i < clonesToAdd; i++) {
        const cloneStart = this.cards[i].cloneNode(true);
        const cloneEnd = this.cards[this.cards.length - 1 - i].cloneNode(true);
        this.track.appendChild(cloneStart);
        this.track.insertBefore(cloneEnd, this.track.firstChild);
      }

      this.allSlides = Array.from(this.track.children);
      this.currentIndex = clonesToAdd;
    }

    getCardsPerView() {
      const width = window.innerWidth;
      if (width <= 749) return 1;
      if (width <= 989) return 2;
      return 4;
    }

    createDots() {
      const totalDots = this.cards.length;
      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('span');
        dot.className = 'testimonials-carousel-dot-{{gen_id}}';
        dot.addEventListener('click', () => this.goToSlide(i));
        this.dotsContainer.appendChild(dot);
      }
      this.dots = Array.from(this.dotsContainer.children);
    }

    setupEventListeners() {
      this.prevButton.addEventListener('click', () => this.navigate('prev'));
      this.nextButton.addEventListener('click', () => this.navigate('next'));

      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => this.startAutoplay());

      let touchStartX = 0;
      let touchEndX = 0;

      this.track.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      });

      this.track.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 50) {
          this.navigate('next');
        } else if (touchEndX - touchStartX > 50) {
          this.navigate('prev');
        }
      });

      window.addEventListener('resize', () => {
        this.updateCarousel(false);
      });
    }

    navigate(direction) {
      if (this.isTransitioning) return;

      if (direction === 'next') {
        this.currentIndex++;
      } else {
        this.currentIndex--;
      }

      this.updateCarousel(true);
    }

    goToSlide(index) {
      if (this.isTransitioning) return;
      const cardsPerView = this.getCardsPerView();
      const clonesToAdd = Math.max(cardsPerView, this.cards.length);
      this.currentIndex = index + clonesToAdd;
      this.updateCarousel(true);
    }

    updateCarousel(animate) {
      const cardsPerView = this.getCardsPerView();
      const cardWidth = this.cards[0].offsetWidth;
      const gap = 24;
      const offset = -(this.currentIndex * (cardWidth + gap));

      if (animate) {
        this.isTransitioning = true;
        this.track.style.transition = 'transform 0.5s ease';
      } else {
        this.track.style.transition = 'none';
      }

      this.track.style.transform = `translateX(${offset}px)`;

      if (animate) {
        setTimeout(() => {
          this.handleInfiniteLoop();
        }, 500);
      }

      this.updateDots();
    }

    handleInfiniteLoop() {
      const cardsPerView = this.getCardsPerView();
      const clonesToAdd = Math.max(cardsPerView, this.cards.length);

      if (this.currentIndex >= this.cards.length + clonesToAdd) {
        this.currentIndex = clonesToAdd;
        this.track.style.transition = 'none';
        const cardWidth = this.cards[0].offsetWidth;
        const gap = 24;
        const offset = -(this.currentIndex * (cardWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
      } else if (this.currentIndex < clonesToAdd) {
        this.currentIndex = this.cards.length + clonesToAdd - 1;
        this.track.style.transition = 'none';
        const cardWidth = this.cards[0].offsetWidth;
        const gap = 24;
        const offset = -(this.currentIndex * (cardWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
      }

      this.isTransitioning = false;
    }

    updateDots() {
      const cardsPerView = this.getCardsPerView();
      const clonesToAdd = Math.max(cardsPerView, this.cards.length);
      const actualIndex = (this.currentIndex - clonesToAdd + this.cards.length) % this.cards.length;

      this.dots.forEach((dot, index) => {
        if (index === actualIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    startAutoplay() {
      this.stopAutoplay();
      this.autoplayInterval = setInterval(() => {
        this.navigate('next');
      }, 5000);
    }

    stopAutoplay() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    }

    disconnectedCallback() {
      this.stopAutoplay();
    }
  }

  customElements.define('testimonials-carousel-{{gen_id}}', TestimonialsCarousel{{gen_id}});
})();
</script>

