    }
  }

  @media screen and (max-width: 480px) {
    .testimonials-slide-{{gen_id}} {
      flex: 0 0 100%;
      margin-right: 0;
    }

    .testimonials-heading-{{gen_id}} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }
