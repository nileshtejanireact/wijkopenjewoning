<script>
  (function() {
    class BodAanvragenForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.totalSteps = 6;
        this.formData = {};
      }

      connectedCallback() {
        this.steps = this.querySelectorAll('[data-step]');
        this.progressFill = this.querySelector('[data-progress-fill]');
        this.currentStepText = this.querySelector('[data-current-step]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.submitButton = this.querySelector('[data-submit]');
        this.form = this.querySelector('form');
        this.thankYou = this.querySelector('[data-thank-you]');
        this.cards = this.querySelectorAll('.ai-bod-form__card-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPreviousStep());
        this.nextButton.addEventListener('click', () => this.goToNextStep());
        
        this.cards.forEach(card => {
          card.addEventListener('click', () => this.handleCardSelection(card));
        });

        this.form.addEventListener('submit', (e) => this.handleSubmit(e));
      }

      handleCardSelection(card) {
        const step = card.closest('[data-step]');
        const cards = step.querySelectorAll('.ai-bod-form__card-{{ ai_gen_id }}');
        const hiddenInput = step.querySelector('input[type="hidden"]');
        const value = card.getAttribute('data-card-value');

        cards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');

        if (hiddenInput) {
          hiddenInput.value = value;
        }
      }

      validateStep(stepNumber) {
        const step = this.querySelector(`[data-step="${stepNumber}"]`);
        const requiredInputs = step.querySelectorAll('[required]');
        let isValid = true;

        requiredInputs.forEach(input => {
          if (!input.value.trim()) {
            isValid = false;
            input.style.borderColor = '{{ block.settings.error_color }}';
          } else {
            input.style.borderColor = '{{ block.settings.input_border_color }}';
          }
        });

        return isValid;
      }

      goToNextStep() {
        if (!this.validateStep(this.currentStep)) {
          return;
        }

        this.saveStepData();

        if (this.currentStep < this.totalSteps) {
          this.currentStep++;
          this.updateStep();
        }
      }

      goToPreviousStep() {
        if (this.currentStep > 1) {
          this.currentStep--;
          this.updateStep();
        }
      }

      saveStepData() {
        const currentStepElement = this.querySelector(`[data-step="${this.currentStep}"]`);
        const fields = currentStepElement.querySelectorAll('[data-field]');

        fields.forEach(field => {
          const fieldName = field.getAttribute('data-field');
          this.formData[fieldName] = field.value;
        });

        if (this.currentStep === 6) {
          this.updateSummary();
        }
      }

      updateSummary() {
        const adres = `${this.formData.straat || ''} ${this.formData.huisnummer || ''}, ${this.formData.postcode || ''} ${this.formData.stad || ''}`;
        
        this.querySelector('[data-summary="adres"]').textContent = adres;
        this.querySelector('[data-summary="woningtype"]').textContent = this.formData.woningtype || '';
        this.querySelector('[data-summary="bouwjaar"]').textContent = this.formData.bouwjaar || '';
        this.querySelector('[data-summary="oppervlakte"]').textContent = this.formData.oppervlakte ? `${this.formData.oppervlakte} m²` : '';
        this.querySelector('[data-summary="kamers"]').textContent = this.formData.kamers || '';
        this.querySelector('[data-summary="staat"]').textContent = this.formData.staat || '';
        this.querySelector('[data-summary="reden"]').textContent = this.formData.reden || '';
        this.querySelector('[data-summary="tijdlijn"]').textContent = this.formData.tijdlijn || '';
        this.querySelector('[data-summary="naam"]').textContent = this.formData.naam || '';
        this.querySelector('[data-summary="email"]').textContent = this.formData.email || '';
        this.querySelector('[data-summary="telefoon"]').textContent = this.formData.telefoon || '';
      }

      updateStep() {
        this.steps.forEach((step, index) => {
          if (index + 1 === this.currentStep) {
            step.classList.add('active');
          } else {
            step.classList.remove('active');
          }
        });

        const progress = (this.currentStep / this.totalSteps) * 100;
        this.progressFill.style.width = `${progress}%`;
        this.currentStepText.textContent = this.currentStep;

        if (this.currentStep === 1) {
          this.prevButton.style.display = 'none';
        } else {
          this.prevButton.style.display = 'block';
        }

        if (this.currentStep === this.totalSteps) {
          this.nextButton.style.display = 'none';
          this.submitButton.style.display = 'block';
        } else {
          this.nextButton.style.display = 'block';
          this.submitButton.style.display = 'none';
        }
      }

      handleSubmit(e) {
        e.preventDefault();

        if (!this.validateStep(this.currentStep)) {
          return;
        }

        const formElement = e.target;
        const formData = new FormData(formElement);

        fetch(formElement.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/javascript'
          }
        }).then(() => {
          this.form.style.display = 'none';
          this.querySelector('[data-navigation]').style.display = 'none';
          this.querySelector('.ai-bod-form__progress-{{ ai_gen_id }}').style.display = 'none';
          this.thankYou.classList.add('active');
        }).catch(() => {
          this.form.style.display = 'none';
          this.querySelector('[data-navigation]').style.display = 'none';
          this.querySelector('.ai-bod-form__progress-{{ ai_gen_id }}').style.display = 'none';
          this.thankYou.classList.add('active');
        });
      }
    }

    customElements.define('bod-aanvragen-form-{{ ai_gen_id }}', BodAanvragenForm{{ ai_gen_id }});
  })();
</script>

