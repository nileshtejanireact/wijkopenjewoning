{% doc %}
  @prompt
    Create an "Our working method" section with two-column layout: image left, numbered steps right.
    
    SECTION LAYOUT:
    - Two columns desktop: left = image (45% width), right = text content
    - Mobile: stack vertically, image top, content below
    - White background, generous padding
    
    BLOCKS (each separately editable):
    1. IMAGE BLOCK: tall image left column, rounded corners, swappable in editor
    2. HEADING BLOCK: "Our working method" - large, bold, dark navy, left-aligned
    3. SUBHEADING BLOCK: "In three clear steps" - gray, left-aligned
    4. STEP BLOCK 1: navy circle with "1", bold title "Register your home", desc "Leave your details. One of our advisors will contact you personally to discuss your situation and wishes."
    5. STEP BLOCK 2: navy circle with "2", bold title "Receive your offer free of charge and without obligation", desc "Based on the condition of your home and comparable homes in the neighborhood, we carefully determine the value and you will receive a no-obligation offer. No viewing is required for this offer."
    6. STEP BLOCK 3: navy circle with "3", bold title "Sell your house and move when it suits you", desc "If you accept our offer, we will finalize the purchase. You determine the moving date."
    7. CTA BUTTON BLOCK: "Request your free offer", dark navy #0D2B5E, white text, rounded, left-aligned, links to "/"
    
    STEP STYLING:
    - Number circle: dark navy #0D2B5E, 36px, bold white number
    - Bold dark navy title, gray description below
    - 24px vertical spacing between steps
    
    STYLING: Horizon theme fonts and colors. Dark navy headings, gray descriptions, white section background.
    
    IMPORTANT: Every element is its own separate block. Do NOT use any CSS class names with ai- prefix. Use Horizon theme standard block types. Responsive: 2 cols desktop, 1 col mobile.
{% enddoc %}
{% assign gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .working-method-container-{{ gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .working-method-grid-{{ gen_id }} {
    display: grid;
    grid-template-columns: 45% 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
  }

  .working-method-image-column-{{ gen_id }} {
    position: relative;
  }

  .working-method-image-{{ gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .working-method-image-placeholder-{{ gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .working-method-image-placeholder-{{ gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .working-method-content-column-{{ gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .working-method-heading-{{ gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .working-method-subheading-{{ gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.4;
  }

  .working-method-step-{{ gen_id }} {
    display: flex;
    gap: {{ block.settings.step_gap }}px;
    align-items: flex-start;
  }

  .working-method-step-number-{{ gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.circle_color }};
    color: {{ block.settings.circle_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.circle_font_size }}px;
    font-weight: 700;
  }

  .working-method-step-content-{{ gen_id }} {
    flex: 1;
  }

  .working-method-step-title-{{ gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .working-method-step-description-{{ gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.step_description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .working-method-button-{{ gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    text-align: center;
  }

  .working-method-button-{{ gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .working-method-grid-{{ gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .working-method-heading-{{ gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .working-method-subheading-{{ gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .working-method-step-title-{{ gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.9 }}px;
    }

    .working-method-step-description-{{ gen_id }} {
      font-size: {{ block.settings.step_description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="working-method-container-{{ gen_id }}" {{ block.shopify_attributes }}>
  <div class="working-method-grid-{{ gen_id }}">
    <div class="working-method-image-column-{{ gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          class="working-method-image-{{ gen_id }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="working-method-image-placeholder-{{ gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="working-method-content-column-{{ gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="working-method-heading-{{ gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="working-method-subheading-{{ gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      {% if block.settings.show_step_1 %}
        <div class="working-method-step-{{ gen_id }}">
          <div class="working-method-step-number-{{ gen_id }}">1</div>
          <div class="working-method-step-content-{{ gen_id }}">
            {% if block.settings.step_1_title != blank %}
              <h3 class="working-method-step-title-{{ gen_id }}">{{ block.settings.step_1_title }}</h3>
            {% endif %}
            {% if block.settings.step_1_description != blank %}
              <p class="working-method-step-description-{{ gen_id }}">{{ block.settings.step_1_description }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_step_2 %}
        <div class="working-method-step-{{ gen_id }}">
          <div class="working-method-step-number-{{ gen_id }}">2</div>
          <div class="working-method-step-content-{{ gen_id }}">
            {% if block.settings.step_2_title != blank %}
              <h3 class="working-method-step-title-{{ gen_id }}">{{ block.settings.step_2_title }}</h3>
            {% endif %}
            {% if block.settings.step_2_description != blank %}
              <p class="working-method-step-description-{{ gen_id }}">{{ block.settings.step_2_description }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_step_3 %}
        <div class="working-method-step-{{ gen_id }}">
          <div class="working-method-step-number-{{ gen_id }}">3</div>
          <div class="working-method-step-content-{{ gen_id }}">
            {% if block.settings.step_3_title != blank %}
              <h3 class="working-method-step-title-{{ gen_id }}">{{ block.settings.step_3_title }}</h3>
            {% endif %}
            {% if block.settings.step_3_description != blank %}
              <p class="working-method-step-description-{{ gen_id }}">{{ block.settings.step_3_description }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="working-method-button-{{ gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

