{% doc %}
  @prompt
    Create a "The benefits of selling directly" comparison section matching Huisunie.nl exactly.
    
    SECTION: Dark navy #0D2B5E background entire section, 80px padding.
    
    BLOCKS:
    1. HEADING BLOCK: "The benefits of selling directly" large bold centered WHITE text
    2. SUBHEADING BLOCK: "Compare Huisunie with selling through a real estate agent" centered light gray text
    
    3. LEFT CARD BLOCK - Huisunie: WHITE background card, 16px rounded, 32px padding. Top: house outline icon light blue #4A9FD4 + "huisunie" text dark navy bold large. Then 7 list items with BLUE FILLED CIRCLE checkmark icons: 1.Sell your home as is 2.A market-rate offer within 24 hours 3.Guaranteed sold without reservation 4.You decide when you move 5.No costs the agreed price is what you receive 6.Hidden defects are our risk 7.Peace clarity and certainty. Bottom: full-width dark navy button "Request a free offer" white text links to "/"
    
    4. RIGHT CARD BLOCK - Broker: Slightly lighter navy #1A3F73 background card, 16px rounded, 32px padding, white border. Top: "Broker" bold white large. Then 7 list items with RED OUTLINED CIRCLE X icons #EF4444: 1.Getting your house ready for sale fixing up tidying up cleaning 2.Endless viewings without certainty about the selling price 3.Buyers who back out due to a financing contingency or structural inspection 4.The buyer decides when you move 5.Spent thousands of euros on real estate agent and notary fees 6.Risk of problems later on due to hidden defects 7.A lot of hassle stress and uncertainty about the sale
    
    STYLING: Both cards equal height. Icons 20px circles. List items 15px line-height 1.6 gap 12px. var(--font-heading-family) var(--font-body-family). Do NOT use CSS class names with ai- prefix. Responsive: 2 cols desktop, 1 col mobile Huisunie first.
{% enddoc %}
{% assign gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .comparison-section-{{gen_id}} {
    display: block;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding }}px 20px;
    width: 100%;
  }

  .comparison-container-{{gen_id}} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .comparison-heading-{{gen_id}} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: bold;
    color: {{ block.settings.heading_color }};
    text-align: center;
    margin: 0 0 16px 0;
  }

  .comparison-subheading-{{gen_id}} {
    font-family: var(--font-body-family);
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    text-align: center;
    margin: 0 0 48px 0;
  }

  .comparison-cards-{{gen_id}} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .comparison-card-{{gen_id}} {
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
  }

  .comparison-card-huisunie-{{gen_id}} {
    background-color: {{ block.settings.huisunie_bg }};
    border: none;
  }

  .comparison-card-broker-{{gen_id}} {
    background-color: {{ block.settings.broker_bg }};
    border: 1px solid {{ block.settings.broker_border }};
  }

  .comparison-card-header-{{gen_id}} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .comparison-card-icon-{{gen_id}} {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .comparison-card-icon-{{gen_id}} svg {
    width: 100%;
    height: 100%;
  }

  .comparison-card-title-{{gen_id}} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: bold;
    margin: 0;
  }

  .comparison-card-title-huisunie-{{gen_id}} {
    color: {{ block.settings.huisunie_title_color }};
  }

  .comparison-card-title-broker-{{gen_id}} {
    color: {{ block.settings.broker_title_color }};
  }

  .comparison-list-{{gen_id}} {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    flex-grow: 1;
  }

  .comparison-list-item-{{gen_id}} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
    font-family: var(--font-body-family);
    font-size: {{ block.settings.list_item_size }}px;
    line-height: 1.6;
  }

  .comparison-list-item-{{gen_id}}:last-child {
    margin-bottom: 0;
  }

  .comparison-list-icon-{{gen_id}} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .comparison-list-icon-{{gen_id}} svg {
    width: 100%;
    height: 100%;
  }

  .comparison-list-text-huisunie-{{gen_id}} {
    color: {{ block.settings.huisunie_text_color }};
  }

  .comparison-list-text-broker-{{gen_id}} {
    color: {{ block.settings.broker_text_color }};
  }

  .comparison-button-{{gen_id}} {
    display: block;
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: var(--font-body-family);
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .comparison-button-{{gen_id}}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  @media screen and (max-width: 768px) {
    .comparison-cards-{{gen_id}} {
      grid-template-columns: 1fr;
    }

    .comparison-heading-{{gen_id}} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .comparison-subheading-{{gen_id}} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .comparison-card-title-{{gen_id}} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="comparison-section-{{gen_id}}" {{ block.shopify_attributes }}>
  <div class="comparison-container-{{gen_id}}">
    <h2 class="comparison-heading-{{gen_id}}">{{ block.settings.heading }}</h2>
    <p class="comparison-subheading-{{gen_id}}">{{ block.settings.subheading }}</p>

    <div class="comparison-cards-{{gen_id}}">
      <div class="comparison-card-{{gen_id}} comparison-card-huisunie-{{gen_id}}">
        <div class="comparison-card-header-{{gen_id}}">
          <div class="comparison-card-icon-{{gen_id}}">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 5L5 15V35H15V25H25V35H35V15L20 5Z" stroke="{{ block.settings.huisunie_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </div>
          <h3 class="comparison-card-title-{{gen_id}} comparison-card-title-huisunie-{{gen_id}}">{{ block.settings.huisunie_title }}</h3>
        </div>

        <ul class="comparison-list-{{gen_id}}">
          {% for i in (1..7) %}
            {% assign item_key = 'huisunie_item_' | append: i %}
            {% if block.settings[item_key] != blank %}
              <li class="comparison-list-item-{{gen_id}}">
                <div class="comparison-list-icon-{{gen_id}}">
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="10" cy="10" r="9" fill="{{ block.settings.huisunie_check_color }}"/>
                    <path d="M6 10L9 13L14 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <span class="comparison-list-text-huisunie-{{gen_id}}">{{ block.settings[item_key] }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <a href="{{ block.settings.button_link }}" class="comparison-button-{{gen_id}}">
          {{ block.settings.button_label }}
        </a>
      </div>

      <div class="comparison-card-{{gen_id}} comparison-card-broker-{{gen_id}}">
        <div class="comparison-card-header-{{gen_id}}">
          <h3 class="comparison-card-title-{{gen_id}} comparison-card-title-broker-{{gen_id}}">{{ block.settings.broker_title }}</h3>
        </div>

        <ul class="comparison-list-{{gen_id}}">
          {% for i in (1..7) %}
            {% assign item_key = 'broker_item_' | append: i %}
            {% if block.settings[item_key] != blank %}
              <li class="comparison-list-item-{{gen_id}}">
                <div class="comparison-list-icon-{{gen_id}}">
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="10" cy="10" r="9" stroke="{{ block.settings.broker_x_color }}" stroke-width="2" fill="none"/>
                    <path d="M7 7L13 13M13 7L7 13" stroke="{{ block.settings.broker_x_color }}" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>
                <span class="comparison-list-text-broker-{{gen_id}}">{{ block.settings[item_key] }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>

