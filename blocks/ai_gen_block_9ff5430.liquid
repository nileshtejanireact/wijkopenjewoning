{% doc %}
  @prompt
    Create a "Frequently Asked Questions" accordion section matching Huisunie.nl exactly.
    
    SECTION: White or #F7F8FA background, 80px padding. FAQ items in 2-COLUMN GRID desktop, 1 col mobile.
    
    BLOCKS:
    1. HEADING BLOCK: "Frequently Asked Questions" bold centered dark navy #0D2B5E
    
    14 FAQ BLOCKS (each separate editable block with question and answer schema fields):
    FAQ1: Q:How quickly will I receive an offer? A:After submitting your details we will contact you within 24 hours with a no-obligation offer.
    FAQ2: Q:Am I obliged to sell if I receive an offer? A:No our offer is completely without obligation. You decide whether you want to accept it.
    FAQ3: Q:How much does it cost to sell my home to Huisunie? A:Nothing. We cover all costs including notary fees. The agreed price is what you receive.
    FAQ4: Q:Will I get a market-rate price? A:We make a fair offer based on the current market value and the condition of your home.
    FAQ5: Q:Do you also buy homes with overdue maintenance or defects? A:Yes we buy homes in any condition. You do not need to repair or renovate anything.
    FAQ6: Q:Why sell in its current state instead of renovating first? A:Renovating costs time and money. We buy your home as is so you save both.
    FAQ7: Q:Do I need to prepare my home for sale? A:No you do not need to clean tidy up or stage your home. We buy it as is.
    FAQ8: Q:How quickly can the sale be completed? A:The sale can be completed within one week or at a time that suits you.
    FAQ9: Q:When do I have to leave my home? A:You decide the transfer date. We are flexible and work around your schedule.
    FAQ10: Q:Can the sale still go wrong after signing? A:No. We buy without financing contingency or structural inspection. Once signed the sale goes through.
    FAQ11: Q:Do you also buy inherited homes? A:Yes we regularly purchase inherited homes and can handle the process quickly and discreetly.
    FAQ12: Q:Can I sell my house if there is still a mortgage on it? A:Yes in most cases this is possible. We will discuss the options with you.
    FAQ13: Q:In which regions does Huisunie buy homes? A:We are active throughout the Netherlands in all provinces and municipalities.
    FAQ14: Q:I have already received an offer. Can I compare that with yours? A:Of course. Our offer is without obligation so you can always compare.
    
    ACCORDION: 2-col grid desktop. Question row: flex between text and + icon. Smooth max-height 0.3s ease expand. One open at a time. + changes to x when open. Border-bottom 1px solid #E5E7EB. Padding 18px 0.
    
    CONTACT BANNER BLOCK (separate editable block): Dark navy #0D2B5E bg, 16px rounded, 32px padding, centered max-width 500px. Flex row: circular avatar left + right side has bold white "Do you have more questions?" + gray "Contact us today" + white outlined button "Receive a no-obligation offer" + phone "023 234 0234" white.
    
    STYLING: Question text navy bold 15px. Answer gray 14px line-height 1.7. var(--font-heading-family) var(--font-body-family). Vanilla JS accordion. Do NOT use CSS class names with ai- prefix. Responsive 2 cols desktop 1 col mobile.
{% enddoc %}
{% assign unique_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .faq-section-{{unique_id}} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    width: 100%;
  }

  .faq-container-{{unique_id}} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .faq-heading-{{unique_id}} {
    text-align: center;
    color: {{ block.settings.heading_color }};
    font-family: var(--font-heading-family);
    font-weight: bold;
    margin-bottom: 40px;
    font-size: 32px;
  }

  .faq-grid-{{unique_id}} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media screen and (min-width: 750px) {
    .faq-grid-{{unique_id}} {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 40px;
    }
  }

  .faq-item-{{unique_id}} {
    border-bottom: 1px solid #E5E7EB;
  }

  .faq-question-{{unique_id}} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-body-family);
    font-size: 15px;
    font-weight: bold;
    color: {{ block.settings.question_color }};
  }

  .faq-question-text-{{unique_id}} {
    flex: 1;
    padding-right: 16px;
  }

  .faq-icon-{{unique_id}} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
    transition: transform 0.3s ease;
  }

  .faq-icon-{{unique_id}}::before,
  .faq-icon-{{unique_id}}::after {
    content: '';
    position: absolute;
    background-color: {{ block.settings.question_color }};
    transition: transform 0.3s ease;
  }

  .faq-icon-{{unique_id}}::before {
    width: 20px;
    height: 2px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .faq-icon-{{unique_id}}::after {
    width: 2px;
    height: 20px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .faq-item-{{unique_id}}.active .faq-icon-{{unique_id}}::after {
    transform: translateX(-50%) rotate(90deg);
  }

  .faq-answer-{{unique_id}} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-answer-content-{{unique_id}} {
    padding: 0 0 18px 0;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.7;
    color: {{ block.settings.answer_color }};
  }

  .faq-contact-banner-{{unique_id}} {
    background-color: {{ block.settings.banner_bg_color }};
    border-radius: 16px;
    padding: 32px;
    margin-top: 40px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .faq-contact-content-{{unique_id}} {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .faq-contact-avatar-{{unique_id}} {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }

  .faq-contact-info-{{unique_id}} {
    flex: 1;
  }

  .faq-contact-title-{{unique_id}} {
    font-family: var(--font-heading-family);
    font-weight: bold;
    color: {{ block.settings.banner_text_color }};
    margin: 0 0 4px 0;
    font-size: 16px;
  }

  .faq-contact-subtitle-{{unique_id}} {
    font-family: var(--font-body-family);
    color: {{ block.settings.banner_subtitle_color }};
    margin: 0 0 12px 0;
    font-size: 14px;
  }

  .faq-contact-button-{{unique_id}} {
    display: inline-block;
    background: transparent;
    color: {{ block.settings.banner_text_color }};
    border: 2px solid {{ block.settings.banner_text_color }};
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 14px;
    margin-bottom: 8px;
    transition: all 0.3s ease;
  }

  .faq-contact-button-{{unique_id}}:hover {
    background-color: {{ block.settings.banner_text_color }};
    color: {{ block.settings.banner_bg_color }};
  }

  .faq-contact-phone-{{unique_id}} {
    display: block;
    color: {{ block.settings.banner_text_color }};
    font-family: var(--font-body-family);
    font-size: 14px;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .faq-contact-content-{{unique_id}} {
      flex-direction: column;
      text-align: center;
    }
  }
{% endstyle %}

<faq-accordion-{{unique_id}} class="faq-section-{{unique_id}}" {{ block.shopify_attributes }}>
  <div class="faq-container-{{unique_id}}">
    {% if block.settings.heading != blank %}
      <h2 class="faq-heading-{{unique_id}}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="faq-grid-{{unique_id}}">
      {% for i in (1..14) %}
        {% assign question_key = 'question_' | append: i %}
        {% assign answer_key = 'answer_' | append: i %}
        {% assign question = block.settings[question_key] %}
        {% assign answer = block.settings[answer_key] %}

        {% if question != blank and answer != blank %}
          <div class="faq-item-{{unique_id}}" data-faq-item>
            <button class="faq-question-{{unique_id}}" aria-expanded="false">
              <span class="faq-question-text-{{unique_id}}">{{ question }}</span>
              <span class="faq-icon-{{unique_id}}"></span>
            </button>
            <div class="faq-answer-{{unique_id}}">
              <div class="faq-answer-content-{{unique_id}}">{{ answer }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_contact_banner %}
      <div class="faq-contact-banner-{{unique_id}}">
        <div class="faq-contact-content-{{unique_id}}">
          {% if block.settings.contact_avatar %}
            <img
              src="{{ block.settings.contact_avatar | image_url: width: 120 }}"
              alt="Contact"
              class="faq-contact-avatar-{{unique_id}}"
              width="60"
              height="60"
              loading="lazy"
            >
          {% endif %}
          <div class="faq-contact-info-{{unique_id}}">
            {% if block.settings.contact_title != blank %}
              <h3 class="faq-contact-title-{{unique_id}}">{{ block.settings.contact_title }}</h3>
            {% endif %}
            {% if block.settings.contact_subtitle != blank %}
              <p class="faq-contact-subtitle-{{unique_id}}">{{ block.settings.contact_subtitle }}</p>
            {% endif %}
            {% if block.settings.contact_button_text != blank and block.settings.contact_button_link != blank %}
              <a href="{{ block.settings.contact_button_link }}" class="faq-contact-button-{{unique_id}}">
                {{ block.settings.contact_button_text }}
              </a>
            {% endif %}
            {% if block.settings.contact_phone != blank %}
              <a href="tel:{{ block.settings.contact_phone | replace: ' ', '' }}" class="faq-contact-phone-{{unique_id}}">
                {{ block.settings.contact_phone }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</faq-accordion-{{unique_id}}>

<script>
  (function() {
    class FaqAccordion{{unique_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('.faq-question-{{unique_id}}');
          const answer = item.querySelector('.faq-answer-{{unique_id}}');

          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');

            this.items.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.classList.remove('active');
                const otherButton = otherItem.querySelector('.faq-question-{{unique_id}}');
                const otherAnswer = otherItem.querySelector('.faq-answer-{{unique_id}}');
                otherButton.setAttribute('aria-expanded', 'false');
                otherAnswer.style.maxHeight = '0';
              }
            });

            if (isActive) {
              item.classList.remove('active');
              button.setAttribute('aria-expanded', 'false');
              answer.style.maxHeight = '0';
            } else {
              item.classList.add('active');
              button.setAttribute('aria-expanded', 'true');
              answer.style.maxHeight = answer.scrollHeight + 'px';
            }
          });
        });
      }
    }

    customElements.define('faq-accordion-{{unique_id}}', FaqAccordion{{unique_id}});
  })();
</script>

